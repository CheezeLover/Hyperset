# Domain — change this one line to switch domains, then restart gateway
HYPERSET_DOMAIN=hyperset.internal

# ── Superset Integration ────────────────────────────────────
# Choose your deployment mode:
#   false (default) = Use external Superset instance (set SUPERSET_UPSTREAM below)
#   true            = Deploy integrated Superset stack (requires SUPERSET_SECRET_KEY)
DEPLOY_WITH_SUPERSET=false

# Address of your Superset instance as seen by Caddy (host:port or https://host)
# When DEPLOY_WITH_SUPERSET=true, this should be: http://hyperset-superset:8088
# When DEPLOY_WITH_SUPERSET=false, set your external Superset URL
SUPERSET_UPSTREAM=http://hyperset-superset:8088

# Public Superset URL for browser iframe embeds (MUST be browser-accessible)
SUPERSET_PUBLIC_URL=https://superset.hyperset.internal

# Public URLs for the portal iframe and pages service.
# podman-compose cannot expand nested ${VAR} inside values, so these must be
# set explicitly. Update to match your HYPERSET_DOMAIN if you change it.
PAGES_PUBLIC_URL=https://pages.hyperset.internal

# Superset secret key (required when DEPLOY_WITH_SUPERSET=true)
# Generate with: openssl rand -base64 42
# ⚠️  MUST be changed when using integrated Superset deployment
SUPERSET_SECRET_KEY=CHANGE_ME_RUN_openssl_rand_base64_42

# Auth crypto key — generate your own with: openssl rand -hex 32
# ⚠️  The value below is a SAMPLE placeholder — replace before first deployment.
AUTH_CRYPTO_KEY=CHANGE_ME_run_openssl_rand_hex_32_and_paste_result_here_min_32_chars

# OAuth credentials (only needed when using an external provider)
OAUTH_CLIENT_ID=placeholder
OAUTH_CLIENT_SECRET=placeholder
ENTRA_TENANT_ID=common
OIDC_METADATA_URL=https://localhost/.well-known/openid-configuration

# Superset MCP service account
# If Superset uses AUTH_REMOTE_USER, set only SUPERSET_MCP_USER (no password needed).
# If Superset uses classic DB auth, set both SUPERSET_MCP_USER and SUPERSET_MCP_PASSWORD.
# To generate secret: openssl rand -hex 32
# ⚠️  The value below is a SAMPLE placeholder — replace before first deployment.
MCP_SERVICE_SECRET=CHANGE_ME_run_openssl_rand_hex_32_and_paste_result_here_min_32_chars
SUPERSET_MCP_USER=admin
SUPERSET_MCP_PASSWORD=

# ── Portal / Chat LLM configuration ───────────────────────────
# Any OpenAI-compatible endpoint works (Mistral, Ollama, vLLM, OpenAI, …).
# Admins can override these at runtime via the settings gear icon in the chat.

LLM_API_URL=https://api.mistral.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=ministral-3b-2512

# Session encryption for admin runtime settings (min 32 chars)
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-very-long-random-secret-key-min-32-chars
