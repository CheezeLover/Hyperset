# SECURITY REQUIREMENTS - READ BEFORE DEPLOYING
# 
# ⚠️  CRITICAL: You MUST change all secrets below before deploying!
#    Run: ./generate-secrets.sh to create secure values automatically
#
# 🔐 Minimum Security Requirements:
#    - All secrets must be 32+ characters
#    - Use only cryptographically secure random values
#    - Never commit .env with real secrets to git
#    - Rotate secrets every 90 days in production

# Domain — change this one line to switch domains, then restart gateway
HYPERSET_DOMAIN=hyperset.internal

# Superset configuration
# Leave blank to use the built-in defaults:
#   SUPERSET_UPSTREAM   -> http://hyperset-superset:8088
#   SUPERSET_PUBLIC_URL -> https://superset.${HYPERSET_DOMAIN}
#   PAGES_PUBLIC_URL    -> https://pages.${HYPERSET_DOMAIN}
#   HYPERSET_PORTAL_URL -> https://${HYPERSET_DOMAIN}
SUPERSET_UPSTREAM=
SUPERSET_PUBLIC_URL=
PAGES_PUBLIC_URL=
HYPERSET_PORTAL_URL=

# ═══════════════════════════════════════════════════════════════
# 🔐 SECURITY: SECRET KEYS - MUST BE CHANGED!
# ═══════════════════════════════════════════════════════════════

# Superset secret key
# CRITICAL: Must be exactly 42 base64-encoded characters
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=CHANGE_ME_RUN_openssl_rand_base64_42

# Database password (auto-generated on first run if not set)
# To manually generate: openssl rand -base64 32
DATABASE_PASSWORD=superset

# Superset admin password (auto-generated on first run if not set)
# CRITICAL: Leave as-is to auto-generate, or set your own strong password
# To manually generate: openssl rand -base64 24
# This password will be preserved across restarts once generated
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_RUN_openssl_rand_base64_24

# Auth crypto key for JWT tokens (min 32 chars hex)
# CRITICAL: This protects all authentication tokens
# Generate with: openssl rand -hex 32
AUTH_CRYPTO_KEY=CHANGE_ME_run_openssl_rand_hex_32_and_paste_result_here_min_32_chars

# MCP service authentication secret (min 32 chars hex)
# CRITICAL: Protects internal API communications
# Generate with: openssl rand -hex 32
MCP_SERVICE_SECRET=CHANGE_ME_run_openssl_rand_hex_32_and_paste_result_here_min_32_chars

# Portal session encryption (min 32 chars)
# CRITICAL: Encrypts user sessions and admin settings
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-very-long-random-secret-key-min-32-chars

# ═══════════════════════════════════════════════════════════════
# 🔓 OAuth Configuration (Optional - only for external providers)
# ═══════════════════════════════════════════════════════════════

OAUTH_CLIENT_ID=placeholder
OAUTH_CLIENT_SECRET=placeholder
ENTRA_TENANT_ID=common
OIDC_METADATA_URL=https://localhost/.well-known/openid-configuration

# ═══════════════════════════════════════════════════════════════
# 👤 Superset MCP Service Account
# ═══════════════════════════════════════════════════════════════

SUPERSET_MCP_USER=admin
# Leave empty if using AUTH_REMOTE_USER (SSO), otherwise set password
SUPERSET_MCP_PASSWORD=

# ═══════════════════════════════════════════════════════════════
# 🤖 LLM Configuration (Optional - for AI chat features)
# ═══════════════════════════════════════════════════════════════

LLM_API_URL=https://api.mistral.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=ministral-3b-2512
