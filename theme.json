{
  "name": "Hyperset Orange Theme",
  "version": "2.0.0",
  "description": "Simplified warm orange theme with unified light/dark color management",
  
  "palette": {
    "primary": {
      "base": "#D35400",
      "dark": "#A04000",
      "light": "#E67E22",
      "lighter": "#F39C12",
      "muted": "#FF8A5C",
      "textLight": "#FFFFFF",
      "textDark": "#0A0A0A"
    },
    "secondary": {
      "base": "#57606F",
      "light": "#747D8C",
      "muted": "#9CA3AF",
      "darkBg": "#2E2E33",
      "darkText": "#FAFAFA"
    },
    "background": {
      "light": "#F8F9FA",
      "dark": "#0A0A0A"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#141414",
      "higher": "#1C1C1C"
    },
    "text": {
      "primary": {
        "light": "#1F2937",
        "dark": "#FF8A5C"
      },
      "secondary": {
        "light": "#4B5563",
        "dark": "#E5E5E5"
      },
      "muted": {
        "light": "#6B7280",
        "dark": "#A3A3A3"
      },
      "inverse": {
        "light": "#0A0A0A",
        "dark": "#FFFFFF"
      },
      "placeholder": {
        "light": "#9CA3AF",
        "dark": "#737373"
      }
    },
    "border": {
      "light": "#DEE2E6",
      "dark": "#404040",
      "secondaryLight": "#E5E7EB",
      "secondaryDark": "#525252"
    },
    "state": {
      "success": {
        "base": "#059669",
        "light": "#10B981",
        "background": "#D1FAE5",
        "backgroundDark": "#064E3B"
      },
      "warning": {
        "base": "#D97706",
        "light": "#F59E0B",
        "background": "#FEF3C7",
        "backgroundDark": "#78350F"
      },
      "error": {
        "base": "#DC2626",
        "light": "#EF4444",
        "background": "#FEE2E2",
        "backgroundDark": "#7F1D1D"
      },
      "info": {
        "base": "#D35400",
        "light": "#E67E22",
        "background": "#FFEDD5",
        "backgroundDark": "#431407"
      }
    },
    "grayscale": {
      "baseLight": "#FFFFFF",
      "light1": "#F5F5F5",
      "light2": "#E5E5E5",
      "light3": "#D4D4D4",
      "light4": "#A3A3A3",
      "light5": "#737373",
      "dark1": "#525252",
      "dark2": "#404040",
      "dark3": "#262626",
      "baseDark": "#0A0A0A"
    }
  },

  "hyperset": {
    "typography": {
      "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
      "headingFont": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
      "codeFont": "JetBrains Mono, Fira Code, monospace"
    },
    "borderRadius": {
      "small": "4px",
      "medium": "8px",
      "large": "12px",
      "pill": "9999px"
    },
    "shadow": {
      "light": {
        "small": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
        "medium": "0 4px 6px -1px rgba(211, 84, 0, 0.1), 0 2px 4px -2px rgba(211, 84, 0, 0.1)",
        "large": "0 10px 15px -3px rgba(211, 84, 0, 0.1), 0 4px 6px -4px rgba(211, 84, 0, 0.1)"
      },
      "dark": {
        "small": "0 1px 2px 0 rgba(0, 0, 0, 0.3)",
        "medium": "0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -2px rgba(0, 0, 0, 0.4)",
        "large": "0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -4px rgba(0, 0, 0, 0.5)"
      }
    }
  },
  
  "superset": {
    "enabled": true,
    "theme": {
      "name": "HypersetOrange"
    }
  },
  
  "logos": {
    "hyperset": {
      "main": "/logos/hyperset-logo.svg",
      "dark": "/logos/hyperset-logo-dark.svg",
      "favicon": "/logos/favicon.ico",
      "appleTouchIcon": "/logos/apple-touch-icon.png"
    }
  },
  
  "branding": {
    "appName": "Hyperset",
    "tagline": "Analytics Portal",
    "companyName": "Your Company",
    "copyright": "© 2026 Hyperset. All rights reserved."
  }
}
